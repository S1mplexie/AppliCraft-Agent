<view class="page">
  <view class="page-head">
    <text class="eyebrow">LANGGRAPH WORKFLOW</text>
    <text class="page-title">生成文书</text>
    <text class="muted head-sub">所有内容都从档案事实清单出发，生成后会自动做事实校验与一次修订。</text>
    <view class="head-accent"></view>
  </view>

  <view class="notice notice-error" wx:if="{{error}}">{{error}}</view>
  <view class="notice" wx:if="{{!llmConfigured && state === 'ready'}}">服务器尚未配置大模型 API Key，暂时无法生成。</view>

  <view class="state-box" wx:if="{{state === 'loading'}}">
    <text class="state-title">正在加载档案…</text>
  </view>
  <view class="state-box" wx:if="{{state === 'error'}}">
    <text class="state-title">加载失败</text>
    <text class="state-desc">{{error}}</text>
    <button class="state-action" bindtap="loadAll">重新加载</button>
  </view>
  <view class="state-box" wx:if="{{state === 'empty'}}">
    <text class="state-title">还没有申请人档案</text>
    <text class="state-desc">先建一份档案，填写教育、经历与目标项目，才能生成文书。</text>
    <button class="state-action" bindtap="goProfiles">去创建档案</button>
  </view>

  <block wx:if="{{state === 'ready'}}">
    <view class="card">
      <view class="picker-head">
        <text class="card-title">当前档案</text>
        <text class="picker-link" bindtap="goProfiles">管理档案 →</text>
      </view>
      <picker range="{{profileLabels}}" value="{{profileIndex}}" bindchange="onProfileChange">
        <view class="picker-value">{{profileLabels[profileIndex] || '请选择档案'}}</view>
      </picker>
      <text class="muted picker-hint">默认使用档案页标记「当前档案」的一份，在这里切换也会同步到文书库。</text>
      <view class="quota-row" wx:if="{{quota}}">
        <text class="muted">今日生成额度</text>
        <text class="tag {{quota.remaining === 0 ? 'tag-warn' : ''}}">{{quota.used}} / {{quota.limit}} 次</text>
      </view>
    </view>

    <view class="card">
      <text class="card-title">文书类型</text>
      <view class="chip-row">
        <view class="chip {{docTypeIndex === index ? 'chip-active' : ''}}" wx:for="{{docTypes}}" wx:key="key"
              data-index="{{index}}" bindtap="pickDocType">{{item.label}}</view>
      </view>
    </view>

    <view class="card">
      <text class="card-title">定制选项</text>
      <view class="field">
        <text class="field-label">目标项目</text>
        <picker range="{{programLabels}}" value="{{programIndex}}" bindchange="onProgramChange">
          <view class="picker-value">{{programLabels[programIndex]}}</view>
        </picker>
      </view>
      <view class="field" wx:if="{{docTypeIndex === 2}}">
        <text class="field-label">推荐人</text>
        <picker range="{{recommenderLabels}}" value="{{recommenderIndex}}" bindchange="onRecommenderChange">
          <view class="picker-value">{{recommenderLabels[recommenderIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">输出语言</text>
        <picker range="{{languageLabels}}" value="{{languageIndex}}" bindchange="onLanguageChange">
          <view class="picker-value">{{languageLabels[languageIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">语气</text>
        <picker range="{{toneLabels}}" value="{{toneIndex}}" bindchange="onToneChange">
          <view class="picker-value">{{toneLabels[toneIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-label">目标字数：{{wordLimit}}</text>
        <slider min="150" max="2000" step="50" value="{{wordLimit}}" show-value activeColor="#3b5bdb" bindchange="onWordLimitChange" />
      </view>
      <view class="field">
        <text class="field-label">补充说明（可选）</text>
        <textarea maxlength="{{-1}}" class="field-textarea" value="{{extraInstructions}}" bindinput="onExtraInput"
                  placeholder="例如：重点突出量化研究能力，不要提及实习经历" placeholder-class="placeholder" />
      </view>
    </view>

    <button class="primary-button" disabled="{{generating}}" bindtap="generate">
      {{generating ? '生成中…' : '开始生成'}}
    </button>
    <text class="muted generate-hint">生成通常需要 1-3 分钟，会依次完成大纲、起草、事实校验与修订。请保持页面在前台。</text>
  </block>

  <view class="mask" wx:if="{{generating}}">
    <view class="mask-card">
      <text class="mask-title">正在生成文书</text>
      <text class="muted mask-time">已用时 {{elapsed}} 秒 · 请勿退出页面</text>
      <view class="node-list">
        <view class="node-item" wx:for="{{nodes}}" wx:key="*this">
          <text class="node-dot">·</text>
          <text class="node-text">{{item}}</text>
        </view>
      </view>
      <text class="muted mask-note">以上是完整生成流程，小程序端为一次性返回结果，非实时节点推送。</text>
    </view>
  </view>
</view>
