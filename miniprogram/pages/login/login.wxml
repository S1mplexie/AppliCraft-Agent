<view class="page login-page">
  <view class="brand">
    <view class="brand-logo">
      <text class="brand-logo-text">A</text>
    </view>
    <text class="eyebrow">APPLICATION DOCUMENT AGENT</text>
    <text class="brand-title">AppliCraft</text>
    <text class="brand-sub">港新及申请制硕士材料生成工作台</text>
  </view>

  <view class="card">
    <text class="card-title">{{bindMode ? '绑定已有账号' : (mode === 'login' ? '登录账号' : '注册新账号')}}</text>

    <view class="notice notice-error" wx:if="{{error}}">{{error}}</view>
    <view class="notice" wx:if="{{hint && !error}}">{{hint}}</view>

    <view class="field">
      <text class="field-label">邮箱账号</text>
      <input maxlength="{{-1}}" class="field-input" type="text" placeholder="name@example.com" placeholder-class="placeholder"
             value="{{email}}" bindinput="onEmailInput" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input maxlength="{{-1}}" class="field-input" password="true" placeholder="至少 8 位" placeholder-class="placeholder"
             value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="field-label">显示名称（可选）</text>
      <input maxlength="{{-1}}" class="field-input" type="text" placeholder="例如：张三" placeholder-class="placeholder"
             value="{{displayName}}" bindinput="onNameInput" />
    </view>

    <button class="primary-button" disabled="{{loading || checking}}" bindtap="submit">
      {{checking ? '正在检查登录状态…' : (loading ? '请稍候…' : (bindMode ? '绑定并登录' : (mode === 'login' ? '登录' : '注册并登录')))}}
    </button>

    <view class="wechat-section" wx:if="{{wechatEnabled && !bindMode}}">
      <view class="divider"><text class="muted">或</text></view>
      <button class="wechat-button" disabled="{{loading || checking}}" bindtap="wechatLogin">微信一键登录</button>
      <text class="muted wechat-hint">首次使用需绑定一次已有账号，之后即可免密登录。</text>
    </view>

    <view class="mode-row" wx:if="{{bindMode}}">
      <text class="muted">绑定后本机微信即可免密登录</text>
      <text class="link" bindtap="exitBindMode">返回登录</text>
    </view>
    <view class="mode-row" wx:elif="{{allowRegistration}}">
      <text class="muted">{{mode === 'login' ? '还没有账号？' : '已有账号？'}}</text>
      <text class="link" bindtap="switchMode">{{mode === 'login' ? '去注册' : '返回登录'}}</text>
    </view>
  </view>

  <view class="card">
    <view class="advanced-head" bindtap="toggleAdvanced">
      <text class="card-title advanced-title">服务器地址</text>
      <text class="muted">{{showAdvanced ? '收起' : '修改'}}</text>
    </view>
    <view wx:if="{{showAdvanced}}">
      <input maxlength="{{-1}}" class="field-input" type="text" placeholder="https://your-domain.com" placeholder-class="placeholder"
             value="{{baseUrl}}" bindinput="onBaseUrlInput" />
      <text class="muted address-hint">填后端根地址，不要带 /api。默认已指向线上服务器，模拟器可直接登录；本地联调可改回 http://127.0.0.1:8000。真机与发布必须使用已备案的 HTTPS 域名，并在小程序后台配置 request 合法域名。</text>
    </view>
    <text class="muted" wx:else>{{baseUrl}}</text>
  </view>

  <view class="footnote">
    <text class="muted">可自助注册新账号，也可使用管理员分配的账号；本服务不发送邮件，忘记密码请联系管理员重置。</text>
    <text class="muted footnote-gap">数据与网页版完全互通，同一账号可看到相同档案与文书。</text>
  </view>
</view>
