.login-page {
  padding-top: 80rpx;
}

.brand {
  display: flex;
  flex-direction: column;
  margin-bottom: 52rpx;
  padding-left: 8rpx;
}

.brand-logo {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #4c6ef5 0%, #3b5bdb 55%, #2f49b0 100%);
  box-shadow: 0 14rpx 32rpx rgba(59, 91, 219, 0.32);
}

.brand-logo-text {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
}

.brand-title {
  margin-top: 16rpx;
  color: #16192b;
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-top: 12rpx;
  color: #7a8496;
  font-size: 27rpx;
}

.placeholder {
  color: #aab2c0;
}

.mode-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.link {
  margin-left: 12rpx;
  color: #3b5bdb;
  font-size: 26rpx;
}

.advanced-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.advanced-title {
  margin-bottom: 0;
}

.address-hint {
  display: block;
  margin-top: 16rpx;
}

.footnote {
  padding: 12rpx 8rpx 40rpx;
}

.footnote .muted {
  display: block;
}

.footnote-gap {
  margin-top: 12rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx 0 20rpx;
}

.wechat-button {
  width: 100%;
  border-radius: 20rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 26rpx rgba(7, 193, 96, 0.28);
}

.wechat-button[disabled] {
  background: #9bdcba;
  color: #ffffff;
  box-shadow: none;
}

.wechat-hint {
  display: block;
  margin-top: 14rpx;
  text-align: center;
}
