<view class="page">
  <view class="page-head">
    <view>
      <text class="eyebrow">SINGLE SOURCE OF TRUTH</text>
      <text class="page-title">申请人档案</text>
      <text class="muted head-sub">标记「当前档案」的一份会作为生成工作台与文书库的默认档案，点卡片可编辑。</text>
      <view class="head-accent"></view>
    </view>
  </view>

  <button class="primary-button create-button" bindtap="createProfile">＋ 新建档案</button>

  <view class="state-box" wx:if="{{state === 'loading'}}">
    <text class="state-title">正在加载档案…</text>
    <text class="state-desc">请稍候</text>
  </view>

  <view class="state-box" wx:elif="{{state === 'error'}}">
    <text class="state-title">加载失败</text>
    <text class="state-desc">{{error}}</text>
    <button class="state-action" bindtap="load">重新加载</button>
  </view>

  <view class="state-box" wx:elif="{{state === 'empty'}}">
    <text class="state-title">还没有档案</text>
    <text class="state-desc">先填写教育、经历与目标项目，之后才能生成 CV、PS 与推荐信。</text>
    <button class="state-action" bindtap="createProfile">创建第一份档案</button>
  </view>

  <view wx:else>
    <view class="card profile-card {{item.isActive ? 'profile-card-active' : ''}}" wx:for="{{items}}" wx:key="id">
      <view class="profile-row" data-id="{{item.id}}" bindtap="editProfile">
        <view class="profile-main">
          <view class="profile-label-row">
            <text class="profile-label">{{item.label}}</text>
            <text wx:if="{{item.isActive}}" class="tag tag-ok">当前档案</text>
          </view>
          <text class="muted profile-sub" wx:if="{{item.name}}">{{item.name}}</text>
          <text class="muted profile-sub" wx:else>尚未填写英文姓名</text>
        </view>
        <text class="tag">编辑</text>
      </view>
      <view class="profile-foot">
        <text class="muted profile-date">更新于 {{item.dateText}}</text>
        <view class="profile-actions">
          <text wx:if="{{!item.isActive}}" class="action-link" data-id="{{item.id}}" catchtap="setActive">设为当前</text>
          <text class="action-link" data-id="{{item.id}}" catchtap="generateWith">基于它生成</text>
          <text class="delete-link" data-id="{{item.id}}" data-label="{{item.label}}" catchtap="removeProfile">删除</text>
        </view>
      </view>
    </view>
    <button class="ghost-button jump-button" bindtap="goGenerate">去生成文书 →</button>
  </view>
</view>
