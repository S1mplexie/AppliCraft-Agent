<view class="page">
  <view class="state-box" wx:if="{{state === 'loading'}}">
    <text class="state-title">正在加载文书…</text>
  </view>
  <view class="state-box" wx:if="{{state === 'error'}}">
    <text class="state-title">加载失败</text>
    <text class="state-desc">{{error}}</text>
    <button class="state-action" bindtap="load">重新加载</button>
  </view>

  <block wx:if="{{state === 'ready'}}">
    <view class="card">
      <text class="doc-title">{{meta.title}}</text>
      <view class="meta-row">
        <text class="tag">{{meta.doc_type_label}}</text>
        <text class="tag {{meta.passed_verification ? 'tag-ok' : 'tag-warn'}}">{{meta.passed_verification ? '校验通过' : '待核对'}}</text>
      </view>
      <text class="muted meta-line">{{dateText}} · {{meta.word_count}} 词 · 第 {{meta.version}} 版 · {{meta.model}}</text>
      <text class="muted meta-line">历史版本 {{versionCount}} 个 · 输出语言 {{meta.language === 'zh' ? '简体中文' : '英文'}}</text>
    </view>

    <view class="action-row" wx:if="{{!editing}}">
      <button class="action-button" bindtap="copyAll">复制全文</button>
      <button class="action-button" bindtap="startEdit">编辑</button>
      <button class="action-button" bindtap="exportDocx">导出 Word</button>
      <button class="action-button action-danger" bindtap="remove">删除</button>
    </view>

    <view class="card" wx:if="{{editing}}">
      <text class="card-title">编辑正文（共 {{editLength}} 字，保存后生成新版本）</text>
      <!-- 微信 textarea 默认 maxlength=140，长文书会被静默截断；数字 -1 表示不限制长度 -->
      <textarea class="edit-area" value="{{editText}}" bindinput="onEditInput" maxlength="{{-1}}" auto-height />
      <view class="edit-actions">
        <button class="ghost-button edit-button" bindtap="cancelEdit">取消</button>
        <button class="primary-button edit-button" disabled="{{saving}}" bindtap="saveEdit">{{saving ? '保存中…' : '保存新版本'}}</button>
      </view>
    </view>

    <view class="card doc-body">
      <text class="card-title">正文</text>
      <block wx:for="{{lines}}" wx:key="idx">
        <text class="md-h1" wx:if="{{item.type === 'h1'}}">{{item.text}}</text>
        <text class="md-h2" wx:elif="{{item.type === 'h2'}}">{{item.text}}</text>
        <text class="md-h3" wx:elif="{{item.type === 'h3'}}">{{item.text}}</text>
        <view class="md-li" wx:elif="{{item.type === 'li'}}">
          <text class="md-bullet">•</text>
          <text class="md-li-text">{{item.text}}</text>
        </view>
        <text class="md-quote" wx:elif="{{item.type === 'quote'}}">{{item.text}}</text>
        <view class="md-blank" wx:elif="{{item.type === 'blank'}}"></view>
        <text class="md-p" wx:else>{{item.text}}</text>
      </block>
    </view>

    <view class="card" wx:if="{{issueCount > 0}}">
      <text class="card-title">事实校验意见（首轮 {{issueCount}} 条）</text>
      <text class="muted section-hint">这些是自动修订前的记录，正文已据此修改；请重点核对下列位置。</text>
      <view class="issue-item" wx:for="{{issues}}" wx:key="idx">
        <text class="tag tag-warn">{{item.label}}</text>
        <text class="issue-quote" wx:if="{{item.quote}}">「{{item.quote}}」</text>
        <text class="muted issue-text">{{item.reason}}</text>
        <text class="muted issue-text" wx:if="{{item.fix}}">建议：{{item.fix}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{outline.length > 0}}">
      <text class="card-title">生成大纲</text>
      <view class="outline-item" wx:for="{{outline}}" wx:key="idx">
        <text class="outline-index">{{item.idx + 1}}</text>
        <view class="outline-main">
          <text class="outline-title">{{item.title}}</text>
          <text class="muted" wx:if="{{item.goal}}">{{item.goal}}</text>
        </view>
      </view>
    </view>

    <text class="muted bottom-note">请人工核对 [TO CONFIRM] 占位符、数字、教授姓名与项目信息后再提交。模型不会替你核实官网截止日期与语言要求。</text>
  </block>
</view>
