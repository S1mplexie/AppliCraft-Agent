<view class="page">
  <view class="page-head">
    <text class="eyebrow">ACCOUNT</text>
    <text class="page-title">我的</text>
    <view class="head-accent"></view>
  </view>

  <view class="state-box" wx:if="{{state === 'loading'}}">
    <text class="state-title">正在加载…</text>
  </view>
  <view class="state-box" wx:if="{{state === 'error'}}">
    <text class="state-title">加载失败</text>
    <text class="state-desc">{{error}}</text>
    <button class="state-action" bindtap="load">重新加载</button>
  </view>

  <block wx:if="{{state === 'ready'}}">
    <view class="card">
      <text class="card-title">账号</text>
      <view class="info-row">
        <text class="muted">邮箱</text>
        <text class="info-value">{{user.email}}</text>
      </view>
      <view class="info-row" wx:if="{{user.display_name}}">
        <text class="muted">显示名称</text>
        <text class="info-value">{{user.display_name}}</text>
      </view>
      <view class="info-row" wx:if="{{quota}}">
        <text class="muted">今日生成</text>
        <text class="info-value">{{quota.used}} / {{quota.limit}} 次（剩余 {{quota.remaining}}）</text>
      </view>
    </view>

    <view class="card">
      <text class="card-title">服务状态</text>
      <view class="info-row">
        <text class="muted">后端地址</text>
        <text class="info-value info-url">{{baseUrl}}</text>
      </view>
      <view class="info-row">
        <text class="muted">生成模型</text>
        <text class="info-value">{{model}}</text>
      </view>
      <view class="info-row">
        <text class="muted">计费方式</text>
        <text class="tag {{billingPersonal ? 'tag-ok' : 'tag-warn'}}">{{billingLabel}}</text>
      </view>
      <view class="info-row">
        <text class="muted">今日免费额度</text>
        <text class="tag {{freeExhausted ? 'tag-warn' : 'tag-ok'}}">{{quotaLabel}}</text>
      </view>
      <view class="info-row">
        <text class="muted">模型配置</text>
        <text class="tag {{llmConfigured ? 'tag-ok' : 'tag-warn'}}">{{llmConfigured ? '已就绪' : '未配置 Key'}}</text>
      </view>
      <view class="address-hint muted">{{freeExhausted ? '今日免费次数已用完：请在网页版「设置 → 我的大模型 API」填入自己的 Key，小程序生成会自动沿用。' : '在网页版「设置 → 我的大模型 API」填入自己的 Key 后，小程序生成会自动沿用。'}}</view>
    </view>

    <view class="card">
      <text class="card-title">修改服务器地址</text>
      <input maxlength="{{-1}}" class="field-input" value="{{editBaseUrl}}" bindinput="onBaseUrlInput" placeholder="https://your-domain.com" placeholder-class="placeholder" />
      <text class="muted address-hint">切换地址后需要重新登录。真机与正式发布必须使用已备案的 HTTPS 域名，并在小程序后台配置为 request 合法域名。</text>
      <button class="ghost-button save-url" bindtap="saveBaseUrl">保存并重新登录</button>
    </view>

    <button class="primary-button logout-button" bindtap="logout">退出登录</button>

    <view class="footnote">
      <text class="muted">档案与文书保存在你自己的服务器上，与网页版共用同一账号和数据。</text>
      <text class="muted footnote-gap">忘记密码请联系管理员在命令行重置；本服务不发送邮件。</text>
    </view>
  </block>
</view>
