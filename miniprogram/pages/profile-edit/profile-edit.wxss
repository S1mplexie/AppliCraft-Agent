.placeholder {
  color: #aab2c0;
}

.section-hint {
  display: block;
  margin-top: -10rpx;
  margin-bottom: 24rpx;
}

.field-gap {
  margin-top: 14rpx;
}

.field-textarea-tall {
  height: 210rpx;
}

.sub-item {
  margin-bottom: 28rpx;
  padding: 26rpx;
  border: 2rpx solid #e6ebf5;
  border-radius: 20rpx;
  background: #f8fafd;
}

.sub-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.sub-title {
  color: #3b5bdb;
  font-size: 27rpx;
  font-weight: 600;
}

.remove-link {
  color: #d64545;
  font-size: 25rpx;
}

.add-button {
  width: 100%;
  font-size: 27rpx;
}

.save-button {
  margin-top: 8rpx;
  margin-bottom: 40rpx;
}
