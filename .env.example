# 复制本文件为 .env 后填写。所有配置项均以 APPLICRAFT_ 为前缀。
# 支持任何 OpenAI 兼容的 /chat/completions 端点（DeepSeek / 混元 / 通义 / OpenAI 等）。

APPLICRAFT_LLM_BASE_URL=https://api.deepseek.com/v1
APPLICRAFT_LLM_API_KEY=
APPLICRAFT_LLM_MODEL=deepseek-chat
APPLICRAFT_LLM_TEMPERATURE=0.5
APPLICRAFT_LLM_TIMEOUT=180
APPLICRAFT_LLM_MAX_RETRIES=2

# 用户自带 Key（BYOK）：开启后每人可在「设置 → 我的大模型 API」填自己的 Key，
# 生成时优先扣自己的额度、且不占用系统每日配额；未配置的人仍回退到上面的系统 Key。
APPLICRAFT_ALLOW_PERSONAL_LLM_KEYS=true
# 设为 true 可强制所有人自带 Key：未配置的用户无法生成，系统 Key 完全不再被他人消耗。
# 注意：强制自带 Key 时必须同时保持 ALLOW_PERSONAL_LLM_KEYS=true，否则用户既无法配置也无法生成。
APPLICRAFT_REQUIRE_PERSONAL_LLM_KEY=false
# 说明：用户 Key 以 Fernet 密文存数据库，主密钥自动生成在 data/.byok_key（随数据卷持久化），
# 不要删除或替换该文件，否则已保存的 Key 需要用户重新填写。
# 非管理员每天可免费使用系统默认 Key 的次数；用完后必须自己配 Key，或等次日重置。
# 由 APPLICRAFT_BOOTSTRAP_EMAIL 指定的管理员账号不受此限制；自带 Key 的用户也不计入。
# 设为 0 表示非管理员一律不得使用系统 Key。
APPLICRAFT_SYSTEM_KEY_DAILY_LIMIT=3

# PostgreSQL（含 pgvector，供多用户与未来 RAG 使用）
# 生产环境务必更换密码、使用 secrets，并删除 compose 里 postgres 的端口映射。
APPLICRAFT_DB_USER=applicraft
APPLICRAFT_DB_PASSWORD=
APPLICRAFT_DB_NAME=applicraft
# 留空 = 默认 SQLite 单文件（本机开发、单机试用），无需数据库容器。
# 生产启用 PostgreSQL 时：在 .env 填下面这行，并用 docker compose --profile postgres up -d --build 启动。
# APPLICRAFT_DATABASE_URL=postgresql+psycopg://applicraft:<password>@postgres:5432/applicraft
# 若后端不经 Docker、直连本机 PostgreSQL，则主机名改为 localhost。

# 多用户与配额（账号密码制，不发送邮件）
# 默认开放注册：访客可自助建号。成本护栏是「系统 Key 每日 3 次免费额度」，
# 用完必须到设置里填自己的 API Key，因此不会无限消耗管理员的模型额度。
# 改为 false 可退回私有模式（账号由 python -m app.cli create-user 分配）；
# 此时数据库为空仍允许自助创建首个账号，建完自动关闭。
APPLICRAFT_DAILY_QUOTA=20
APPLICRAFT_ALLOW_REGISTRATION=true
APPLICRAFT_BOOTSTRAP_FIRST_USER=true
APPLICRAFT_SESSION_DAYS=14

# 默认管理员账号（部署时由 sync-admin 自动同步，改这里再部署即可换账密）。
# 明文只放在 .env（600 权限、已在 .gitignore 中），不要写进仓库、镜像或聊天记录。
# 两项必须同时填写；留空则不创建默认账号。已存在同名账号时，只有密码不一致才会改密并吊销旧会话。
# APPLICRAFT_BOOTSTRAP_EMAIL=you@example.com
# APPLICRAFT_BOOTSTRAP_PASSWORD=
# 公网 HTTPS 部署时必须设为 true，否则 Cookie 可能被明文传输。
APPLICRAFT_COOKIE_SECURE=false
APPLICRAFT_COOKIE_SAMESITE=lax
# 仅在后端位于可信反向代理之后时开启；开启后会信任 X-Forwarded-For。
APPLICRAFT_TRUST_PROXY_HEADERS=false
# 反向代理的对外地址，例如 https://apply.example.com，用于跨站请求校验。
# APPLICRAFT_PUBLIC_ORIGIN=https://apply.example.com
# 同一 IP 在 10 分钟内的失败登录 / 注册尝试上限（进程内计数，单实例适用）。
# 开放注册时建议保持 10，避免同一校园网/办公网出口下多人注册被误伤。
APPLICRAFT_LOGIN_MAX_ATTEMPTS=10
APPLICRAFT_REGISTER_MAX_ATTEMPTS=10

# 微信小程序一键登录（可选，AppID 与 AppSecret 都配齐才开启；账号密码登录始终可用）
# AppID 是公开信息，AppSecret 是密钥：只放 .env，绝不写进小程序代码或提交到仓库。
# 在微信公众平台 mp.weixin.qq.com →「开发管理 → 开发设置」取得 AppID / AppSecret；
# miniprogram/project.config.json 里的 appid 必须与这里一致，否则 code2session 会报 40013。
APPLICRAFT_WECHAT_APPID=wx14c6a873042c0570
# APPLICRAFT_WECHAT_SECRET=
# 默认关闭自动建号：新微信需先用账号密码登录一次完成绑定，避免陌生人消耗模型额度。
# 对外开放服务时才设为 true。
# APPLICRAFT_WECHAT_AUTO_REGISTER=false

# RAG 预留：本阶段不接入生成流程。DeepSeek 不提供 embedding 端点，
# 将来可指向任意 OpenAI 兼容的 embedding 服务。
# APPLICRAFT_EMBEDDING_BASE_URL=
# APPLICRAFT_EMBEDDING_API_KEY=
# APPLICRAFT_EMBEDDING_MODEL=
# APPLICRAFT_EMBEDDING_DIM=1536

# 以下仅在本地直接运行（非 Docker）时按需覆盖：
# APPLICRAFT_DATA_DIR=D:/AppliCraft/backend/data
# APPLICRAFT_STATIC_DIR=D:/AppliCraft/frontend/dist
# APPLICRAFT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# APPLICRAFT_MAX_REVISIONS=1
