# AppliCraft 本地部署版 —— 环境变量示例
# 用法：复制本文件为 .env（与本文件同级，即仓库根目录）并填写。
# 全部变量以 APPLICRAFT_ 开头；也可不填，直接在网页「设置 → 我的大模型 API」里配置，二者等价。
# 网页里保存的配置会写入 backend/data/local_llm.json（仅本机）。

# —— 你自己的大模型 API Key（必填其一：这里填，或网页里填）——
APPLICRAFT_LLM_API_KEY=

# —— OpenAI 兼容接口地址（含 /v1）——
APPLICRAFT_LLM_BASE_URL=https://api.deepseek.com/v1

# —— 模型名称 ——
APPLICRAFT_LLM_MODEL=deepseek-chat

# —— 服务端口（可选，默认 8000；改后请访问 http://localhost:<端口>）——
# APPLICRAFT_PORT=8000

# 说明：本地版默认 standalone=True，免登录、单用户、所有数据存本机 backend/data/。
# 不需要配置数据库、注册、管理员等网页版（SaaS）专属项。
